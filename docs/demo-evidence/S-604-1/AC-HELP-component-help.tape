Output docs/demo-evidence/S-604-1/AC-HELP-component-help.gif
Output docs/demo-evidence/S-604-1/AC-HELP-component-help.webm

Require jr

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 13
Set Width 1100
Set Height 500
Set Theme "Dracula"
Set Padding 20

# Show command surface: jr component --help
Type "jr component --help"
Enter
Sleep 2s
